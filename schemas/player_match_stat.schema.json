{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "player_match_stat.schema.json",
  "title": "PlayerMatchStat",
  "type": "object",
  "required": ["canonical_player_id","season_id","giornata","role","vote_source","league_rule_version","source_id","retrieved_at","raw_hash","transform_version","confidence"],
  "properties": {
    "canonical_player_id": {"type": "string"},
    "season_id": {"type": "integer"},
    "giornata": {"type": "integer", "minimum": 1, "maximum": 38},
    "role": {"enum": ["P","D","C","A"]},
    "serie_a_team_id": {"type": "string"},
    "opponent_id": {"type": "string"},
    "home_away": {"enum": ["home","away"]},
    "vote_source": {"enum": ["italia","gazzetta"]},
    "league_rule_version": {"type": "string"},
    "voto_base": {"type": ["number","null"]},
    "is_sv": {"type": "boolean"},
    "bonus": {"type": "number"},
    "malus": {"type": "number"},
    "fantavoto": {"type": ["number","null"]},
    "minutes": {"type": "integer", "minimum": 0, "maximum": 120},
    "starter": {"type": "boolean"},
    "goals": {"type": "integer"},
    "assists": {"type": "integer"},
    "yellow": {"type": "integer"},
    "red": {"type": "integer"},
    "own_goals": {"type": "integer"},
    "pen_scored": {"type": "integer"},
    "pen_missed": {"type": "integer"},
    "pen_saved": {"type": "integer"},
    "goals_conceded": {"type": "integer"},
    "clean_sheet": {"type": "boolean"},
    "xG": {"type": ["number","null"]},
    "xA": {"type": ["number","null"]},
    "source_id": {"type": "string"},
    "field_license": {"type": "string"},
    "retrieved_at": {"type": "string"},
    "raw_hash": {"type": "string"},
    "transform_version": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
