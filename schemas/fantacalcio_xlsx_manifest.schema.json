{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fantacalcio_xlsx_manifest.schema.json",
  "title": "FantacalcioXlsxManifest",
  "description": "Provenance manifest for one private Fantacalcio XLSX processed raw -> normalized using the authoritative Redazione Italia sheet. Real XLSX files live in private storage and never in the repo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "vote_source",
    "season",
    "matchday",
    "raw_filename",
    "raw_hash",
    "normalized_filename",
    "normalized_hash",
    "transform_version",
    "source_license",
    "storage_allowed",
    "derived_use_allowed",
    "automation_allowed",
    "redistribution_allowed",
    "drive_root_folder_id",
    "raw_drive_folder_id",
    "normalized_drive_folder_id",
    "drive_visibility",
    "shared_link_enabled",
    "auth_secret_ref",
    "retrieved_at"
  ],
  "properties": {
    "source_id": {"const": "fantacalcio_xlsx"},
    "vote_source": {"const": "italia"},
    "season": {"type": "string", "description": "e.g. 2024_25", "pattern": "^[0-9]{4}_[0-9]{2}$"},
    "matchday": {"type": "integer", "minimum": 1, "maximum": 38},
    "raw_filename": {"type": "string", "minLength": 1},
    "raw_hash": {"type": "string", "description": "sha256 of immutable raw XLSX bytes, computed before transform", "pattern": "^[a-f0-9]{64}$"},
    "normalized_filename": {"type": "string", "minLength": 1},
    "normalized_hash": {"type": "string", "description": "sha256 of normalized Redazione Italia output", "pattern": "^[a-f0-9]{64}$"},
    "transform_version": {"type": "string", "minLength": 1},
    "source_license": {"const": "proprietary_personal_use"},
    "storage_allowed": {"const": "private_drive_only"},
    "derived_use_allowed": {"const": "personal_only"},
    "automation_allowed": {"const": "private_orchestrated_only"},
    "redistribution_allowed": {"const": false},
    "drive_root_folder_id": {"type": "string", "minLength": 1, "description": "Runtime private Drive root id; never commit the real id."},
    "raw_drive_folder_id": {"type": "string", "minLength": 1, "description": "Runtime private Raw folder id; never commit the real id."},
    "normalized_drive_folder_id": {"type": "string", "minLength": 1, "description": "Runtime private Normalized Drive folder id; never commit the real id."},
    "drive_visibility": {"const": "private"},
    "shared_link_enabled": {"const": false},
    "auth_secret_ref": {"type": "string", "minLength": 1, "description": "Symbolic credential reference only, never a token value."},
    "retrieved_at": {"type": "string", "format": "date-time"}
  }
}
