{
  "name": "fantacalcio-auction-copilot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Fantacalcio Auction Copilot — public core (engine + UI + contracts). Personal use.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "secret-scan": "node scripts/secret-scan.mjs",
    "repo-guardrails": "node scripts/repo-guardrails.mjs",
    "publication-gate": "node scripts/publication-gate.mjs",
    "check-links": "node scripts/check-markdown-links.mjs",
    "lint-workflows": "node scripts/lint-workflows.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run secret-scan && npm run repo-guardrails && npm run publication-gate && npm run check-links"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^26.1.0",
    "exceljs": "^4.4.0",
    "node-html-parser": "^9.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
